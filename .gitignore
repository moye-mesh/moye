# Dependencies/build artifacts (regenerated by npm install / cargo build)
node_modules/
sdk/rust/target/
sdk/**/target/
*.rlib
*.so
__pycache__/
*.pyc

# Runtime data/identity keys -- must never go into the public repo
a2a/data/
a2a/orbitdb/
a2a/.ipfs_root_cid
a2a/scratch/
*.db
*.db-journal
*.db-wal
*.db-shm
*.pem
*.key
*-libp2p-key.bin

# Internal-only planning docs (ADRs/PLAN/mission tickets/identity material) -- never tracked so
# far by convention only; pinning it explicitly so a stray `git add -A` can't pull it in.
a2a/docs/

# Old a2a-only git history backup (not part of this new repo)
a2a/.git.old-a2a-only-history/

# Cloudflare CLI local cache (contains account metadata, not source code)
.wrangler/
cloudflare-worker/.wrangler/
cloudflare-pages/.wrangler/

# Logs/system files
*.log
npm-debug.log*
.DS_Store
.env
.env.local

# Local tool config + self-referencing symlinks (legacy links pointing at . itself, not project source)
.claude/
/moye
/www
/api/
